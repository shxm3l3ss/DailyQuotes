<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Finlandica+Headline:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
    <title>Daily Quote</title>
</head>

<body>
    <div class="card-container" onclick="flipCard(this)">
        <p style="font-size: 40px; margin: 5px; color: white; font-weight: bold;">Frase del Día</p>

        <div class="card-inner">
            <% if (locals.dailyQuote) {%>
                <div class="card-front">
                    <p style="font-size: 34px; color: black;">Haz click para dar vuelta <span
                            class="click-hint">✨</span></p>
                </div>
                <div class="card-back">
                    <p class="quote">
                        "<%= dailyQuote.value %>"
                    </p>
                    <p class="book">
                        <%= dailyQuote.book %>
                    </p>
                </div>
                <%} else { %>
                    <p>Error while getting the quote</p>
                    <% } %>
        </div>
    </div> 
    <script>

        var background = "";
  
        const currentBook = '<%- dailyQuote.book %>';

        if (currentBook === "Donde todo brilla"){
        
            background = "donde-todo-brilla";

        }
        else if(currentBook === "La teoría de los archipiélagos"){

            background = "la-teoria-de-los-archipielagos";

        }
        else if (currentBook === "El día que dejó de nevar en Alaska"){

            background = "El-día-que-dejo-de-nevar-en-Alaska";

        }
        else if (currentBook === "El chico que dibujaba constelaciones"){

            background = "El-chico-que-dibujaba-constelaciones";

        }
        else if(currentBook === "Nosotros en la luna"){

            background = "Nosotros-en-la-luna";

        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelector(".card-container").classList.add(background);
        });

        function flipCard(cardContainer) {
            cardContainer.classList.toggle('flipped');
        }

    </script>
</body>

</html>